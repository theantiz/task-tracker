# Maven / Spring Boot
target/
!.mvn/wrapper/maven-wrapper.properties

# If you ever have nested modules with their own targets:
**/target/

# Keep tracked production build output if you generate it under src
!**/src/main/**/target/
!**/src/test/**/target/

# Maven Wrapper (no binaries/scripts in root or .mvn)
.mvn/wrapper/maven-wrapper.jar
mvnw
mvnw.cmd

